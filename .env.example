# Copy this file to ".env" and fill in what you need. Everything is optional.
# .env is private: it is ignored by git and never shared.

# Online subtitle search: free API key from https://www.opensubtitles.com/consumers
OPENSUBTITLES_API_KEY=
# Optional OpenSubtitles login: raises the daily download limit from 5 to 20
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# Permanent public address (Cloudflare Tunnel token, see README)
TUNNEL_TOKEN=

# Web port on this computer (default 8080)
# WEB_PORT=8080

# Keep downloaded videos instead of deleting them when nobody watches
# KEEP_DOWNLOADS=false
# IDLE_MINUTES=30
# MAX_ACTIVE_TORRENTS=3
# MIN_FREE_GB=2

# Your timezone for Prowlarr, e.g. Europe/Berlin
# TZ=Etc/UTC

# Optional extra Jackett/Torznab indexer
# TORZNAB_URL=http://192.168.1.10:9117/api/v2.0/indexers/all/results/torznab
# TORZNAB_APIKEY=
